LIGHTNING_API_URL=https://lightning-agent.onrender.com
LIGHTNING_APP_URL=https://lightning-agent.onrender.com/app/
VIDEO_VISUAL_MODE=app
VIDEO_ENGINE_TOKEN=replace-with-a-private-token
VIDEO_OUTPUT_DIR=./output
VIDEO_INTERVAL_HOURS=2
VIDEO_TIMEZONE=America/Belem
EDGE_TTS_VOICE=pt-BR-FranciscaNeural
PRESENTER_SPEED=1.0
NARRATION_SPEED=0.90
# Optional external runtime: set these when models/venv are stored elsewhere.
# LIPSYNC_PYTHON=/path/to/venv/bin/python
# WAV2LIP_ROOT=/path/to/Wav2Lip

# One-time deploy input: direct model URL or accessible Google Drive sharing link.
WAV2LIP_CHECKPOINT_URL=https://drive.google.com/file/d/1UC_U4l66nZbQE5Fz0SaQ77Oxa6JBGfRf/view?usp=drive_link
# Hash defaults to deploy/model.json; override only for a separately validated model.
# WAV2LIP_CHECKPOINT_SHA256=
# WAV2LIP_CHECKPOINT=/data/models/wav2lip-compatible.pth
